# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
# For Railway: DATABASE_URL is automatically provided when you add PostgreSQL service
# For local development: use the connection string below
DATABASE_URL=postgresql://username:password@localhost:5432/profsidekick

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Application Configuration
APP_NAME=ProfSidekick API
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your_secret_key_here

# File Upload Configuration
UPLOAD_DIR=./uploads
STATIC_DIR=./static
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=.pptx,.ppt,.pdf

# Cloud Storage Configuration (AWS S3)
# Set USE_CLOUD_STORAGE=true to enable cloud storage instead of local files
USE_CLOUD_STORAGE=false
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name
S3_BUCKET_REGION=us-east-1
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# Server Configuration
HOST=0.0.0.0
# For Railway: PORT is automatically provided by Railway
# For local development: use 8000
PORT=8000

# Security
# Add your Railway app domain after deployment (e.g., https://your-app-name.up.railway.app)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://profsidekick.vercel.app

# Email Configuration
# Choose email service: smtp (local dev), sendgrid (production), resend (production)
# For Railway/production, use SendGrid or Resend (SMTP ports are blocked)
EMAIL_SERVICE=smtp

# SMTP Configuration (for local development only)
# For Gmail: Use App Password (not your regular password)
# 1. Enable 2FA on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=ProfSidekick

# SendGrid Configuration (recommended for production - Railway, Heroku, etc.)
# 1. Sign up at https://sendgrid.com (free tier: 100 emails/day)
# 2. Get API key from Settings > API Keys
# 3. Verify your sender email at https://sendgrid.com/verify_sender
# Set EMAIL_SERVICE=sendgrid to use
SENDGRID_API_KEY=your-sendgrid-api-key

# Resend Configuration (alternative for production)
# 1. Sign up at https://resend.com (free tier: 100 emails/day)
# 2. Get API key from dashboard
# 3. Add and verify your domain
# Set EMAIL_SERVICE=resend to use
RESEND_API_KEY=your-resend-api-key

# Email Verification & Approval
# Email addresses that will receive approval requests for new users (comma-separated for multiple)
# Example: professor1@example.com,professor2@example.com,admin@example.com
PROFESSOR_APPROVAL_EMAILS=professor-email@example.com
# Frontend URL for email links (verification & approval)
FRONTEND_URL=http://localhost:3000 