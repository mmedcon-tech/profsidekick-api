# Copy to .env and fill in secrets. Do not commit real credentials.

SECRET_KEY=change-me
DEBUG=true
BYPASS_EMAIL_VERIFICATION=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql://profsidekick:password123@postgres:5432/profsidekick
REDIS_URL=redis://redis:6379/0

EMAIL_SERVICE=smtp
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@myos.sk
SMTP_FROM_NAME=MyOS

# Optional: comma-separated professor emails for post-verify approval.
# Leave empty to auto-approve after email verification.
PROFESSOR_APPROVAL_EMAILS=

# Streaming talking-head renderer (HeyGen). The API mints tokens for signed-in users only.
HEYGEN_ENABLED=false
HEYGEN_API_KEY=
# LiveAvatar (HeyGen) streaming avatar, used when HEYGEN_ENABLED=true
LIVEAVATAR_API_KEY=
LIVEAVATAR_DEFAULT_AVATAR_ID=
LIVEAVATAR_SANDBOX=false
# ElevenLabs: voice list and instant voice clones on the avatar settings page
ELEVENLABS_API_KEY=
VOICE_CLONE_DAILY_LIMIT=5
