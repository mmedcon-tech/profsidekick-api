# Ensure shell scripts and SQL always use LF on checkout (never CRLF)
# Prevents "exec /entrypoint.sh: no such file or directory" on Linux containers
*.sh  text eol=lf
*.sql text eol=lf

*.pdf filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
